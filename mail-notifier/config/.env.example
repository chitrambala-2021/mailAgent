# Copy this file to the project root as ".env" and fill in what you use.
#   cp config/.env.example .env

# --- Outlook / Microsoft 365 (Azure app registration) ---
OUTLOOK_CLIENT_ID=
# "organizations" = any work/school tenant, or your tenant GUID / domain
OUTLOOK_TENANT_ID=organizations

# --- Claude (only if ai_triage.enabled = true) ---
ANTHROPIC_API_KEY=

# --- Slack (Incoming Webhook URL) ---
SLACK_WEBHOOK_URL=

# --- Microsoft Teams (Workflows "When a Teams webhook request is received" URL) ---
TEAMS_WEBHOOK_URL=

# --- Email alerts via SMTP ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- ntfy (optional, only for protected topics) ---
NTFY_TOKEN=
